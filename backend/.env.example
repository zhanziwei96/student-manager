# ============================================
# 班级管理系统 - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改
# ============================================

# ========== 应用基础配置 ==========
# 运行环境: development 或 production
ENV=production

# 调试模式: true 或 false
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8000

# ========== 数据库配置 ==========
# SQLite 数据库文件路径（默认: 项目根目录/data/class_system.db）
# DB_PATH=/path/to/your/database.db

# 数据库连接超时（秒）
DB_TIMEOUT=30

# ========== Redis 配置 ==========
# Redis 连接 URL
REDIS_URL=redis://localhost:6379

# Redis 连接池大小
REDIS_POOL_SIZE=10

# ========== 缓存配置 ==========
# 是否启用缓存
CACHE_ENABLED=true

# 默认缓存 TTL（秒）
CACHE_TTL=60

# 学生列表缓存 TTL（秒）
CACHE_STUDENT_LIST_TTL=60

# 学生详情缓存 TTL（秒）
CACHE_STUDENT_DETAIL_TTL=300

# 统计数据缓存 TTL（秒）
CACHE_STATS_TTL=60

# 用户列表缓存 TTL（秒）
CACHE_USER_LIST_TTL=300

# 班级列表缓存 TTL（秒）
CACHE_CLASS_LIST_TTL=1800

# 审计统计缓存 TTL（秒）
CACHE_AUDIT_STATS_TTL=300

# ========== 安全配置 ==========
# Session 加密密钥（生产环境必须修改！）
SECURITY_SECRET_KEY=your-secret-key-here-change-in-production

# Session 有效期（秒）
SECURITY_SESSION_MAX_AGE=86400

# 密码最小长度
SECURITY_PASSWORD_MIN_LENGTH=6

# 用户名最小长度
SECURITY_USERNAME_MIN_LENGTH=3

# 最大登录失败次数
SECURITY_MAX_LOGIN_FAILURES=5

# 登录锁定持续时间（分钟）
SECURITY_LOCKOUT_DURATION_MINUTES=30

# CORS 允许的来源（逗号分隔）
SECURITY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Secure 标志（生产环境必须设为 true，配合 HTTPS）
SECURITY_COOKIE_SECURE=true

# ========== 限流配置 ==========
# 是否启用限流
RATE_LIMIT_ENABLED=true

# 登录接口限流: 次数/窗口秒数
RATE_LIMIT_LOGIN_MAX_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# 签到接口限流
RATE_LIMIT_CHECKIN_MAX_REQUESTS=10
RATE_LIMIT_CHECKIN_WINDOW_SECONDS=60

# 分数修改限流
RATE_LIMIT_SCORE_CHANGE_MAX_REQUESTS=10
RATE_LIMIT_SCORE_CHANGE_WINDOW_SECONDS=60

# 用户查询限流
RATE_LIMIT_USER_SEARCH_MAX_REQUESTS=10
RATE_LIMIT_USER_SEARCH_WINDOW_SECONDS=60

# 默认限流
RATE_LIMIT_DEFAULT_MAX_REQUESTS=60
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# ========== 日志配置 ==========
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 单个日志文件最大大小（字节）
LOG_MAX_FILE_BYTES=10485760

# 备份文件数量
LOG_BACKUP_COUNT=5

# 审计日志保留天数
LOG_AUDIT_RETENTION_DAYS=90

# ========== 分页配置 ==========
# 默认分页大小
PAGINATION_DEFAULT_PAGE_SIZE=20

# 审计日志最大返回数量
PAGINATION_MAX_AUDIT_LOGS=100

# 签到记录最大返回数量
PAGINATION_MAX_CHECKIN_RECORDS=200

# ========== 分数配置 ==========
# 默认分数
SCORE_DEFAULT_SCORE=70

# 签到奖励分数
SCORE_CHECKIN_REWARD=0.5

# 迟到惩罚分数
SCORE_LATE_PENALTY=-0.2

# ========== 文件上传配置 (SEC-001) ==========
# 允许上传的文件扩展名（JSON数组格式）
UPLOAD_ALLOWED_EXTENSIONS=[".xlsx",".xls"]

# 允许的文件MIME类型（JSON数组格式）
UPLOAD_ALLOWED_CONTENT_TYPES=["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.ms-excel"]

# 最大文件大小（MB）
UPLOAD_MAX_FILE_SIZE_MB=10

# 上传文件存储目录
UPLOAD_DIRECTORY=uploads

# 是否使用UUID重命名文件（true为安全推荐）
UPLOAD_USE_UUID_FILENAME=true

# ========== 学期配置（第二学期引入） ==========
# 当前学期标识（学年+学期号：1=秋季 2=春季）
TERM_CFG__LABEL=2026-2027-1

# 学期开始日期（第1周周一）
TERM_CFG__START_DATE=2026-09-07

# 学期总周数
TERM_CFG__TOTAL_WEEKS=20
