# 生产环境配置模板（.env.production.example）
# 复制为 .env.production 并填入真实值
# 注意：.env.production 被 gitignore，不入库

# 应用配置
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置（Docker 内部网络，容器名 classhub-postgres）
DATABASE__URL=postgresql+psycopg2://classhub:CHANGE_ME@postgres:5432/classhub

# 安全配置 - 生产环境必须使用强密钥（至少 32 字符）
SECURITY__SECRET_KEY=CHANGE_ME_to_a_strong_random_key_at_least_32_chars
SECURITY__SESSION_MAX_AGE=86400
SECURITY__PASSWORD_MIN_LENGTH=6
SECURITY__USERNAME_MIN_LENGTH=3
SECURITY__MAX_LOGIN_FAILURES=5
SECURITY__LOCKOUT_DURATION_MINUTES=30

# Cookie Secure 标志（生产环境必须 true，配合 HTTPS）
SECURITY__COOKIE_SECURE=true

# CORS 允许的来源（JSON 数组格式）
SECURITY__CORS_ORIGINS=["https://your-domain.com"]

# 限流配置
RATE_LIMIT__ENABLED=true
RATE_LIMIT__LOGIN_MAX_REQUESTS=5
RATE_LIMIT__LOGIN_WINDOW_SECONDS=60
RATE_LIMIT__CHECKIN_MAX_REQUESTS=100
RATE_LIMIT__CHECKIN_WINDOW_SECONDS=10

# 日志配置
LOG__LEVEL=INFO

# 文件上传配置
UPLOAD__MAX_FILE_SIZE_MB=10

# 学期配置（第二学期）
# 注意：env 键是 TERM_CFG__（validation_alias="term_cfg"），不是 TERM__
TERM_CFG__LABEL=2026-2027-1
TERM_CFG__START_DATE=2026-09-07
TERM_CFG__TOTAL_WEEKS=20
