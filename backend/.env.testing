# 测试环境配置文件
# 运行测试时使用: ENV=testing python main.py

# 应用环境
ENV=testing
DEBUG=true

# 测试数据库路径（注意：使用 DATABASE__ 前缀表示嵌套配置）
DATABASE__PATH=./data/student_manage.db

# 限流配置 - 测试时放宽限制（100倍）
RATE_LIMIT__MULTIPLIER=100

# Redis 配置
REDIS__URL=redis://localhost:6379

# 安全配置
SECURITY__SECRET_KEY=test-secret-key-for-testing-only
SECURITY__SESSION_MAX_AGE=86400
