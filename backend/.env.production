# 生产环境配置

# 应用环境
ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置（使用绝对路径）
DATABASE__PATH=/home/yufeng/student-manage-v3-security/student-manager/backend/data/class_system.db

# Redis 配置
REDIS__URL=redis://localhost:6379

# 安全配置 - 生产环境必须修改密钥
SECURITY__SECRET_KEY=local-dev-secret-key-min-32-characters-long
SECURITY__SESSION_MAX_AGE=86400

# 限流配置
RATE_LIMIT__MULTIPLIER=1

# 日志配置
LOG__LEVEL=INFO
LOG__FILE=./logs/production.log
